meta {
  name: Unknown Route
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/test-route-for-unknown-route
  body: none
  auth: none
}

assert {
  res.status: eq 404
  res.body.success: eq false
  res.body.status: eq 404
  res.body.data: isNull
  res.body.error.code: eq ROUTE_NOT_FOUND
}

docs {
  # Unknown Route — 404
  
  Anything that matches no route at all:
  
  ```json
  { "error": { "code": "ROUTE_NOT_FOUND", "message": "Cannot GET /api/nope" } }
  ```
  
  Distinct from `SECTION_NOT_FOUND`: this means the URL matched nothing,
  whereas `SECTION_NOT_FOUND` means the route matched but the identifier
  was not a real section.
  
  Produced by the `notFound` middleware, which hands a `HttpError` to the
  error handler rather than responding itself — one place stays responsible
  for the response shape.
}
