meta {
  name: Hero
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/home/hero
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.status: eq 200
  res.body.error: isNull
  res.body.data.headline: isArray
  res.body.data.description: isString
  res.body.data.primaryCta: isString
}

docs {
  # Hero

  `GET /api/home/hero` → the `hero` slice of `HomeContent`.

  Headline segments, supporting copy, the primary CTA label, and the banner image. The headline is an array of segments rather than a string so the brand-coloured words can be marked up per run and wrap differently across breakpoints.

  The section payload arrives under `data`; see the collection docs for the
  response envelope.
}
