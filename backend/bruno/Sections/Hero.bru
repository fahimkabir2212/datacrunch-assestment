meta {
  name: Hero
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/home/hero
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.headline: isArray
  res.body.description: isString
  res.body.primaryCta: isString
}

docs {
  # Hero

  `GET /api/home/hero` → the `hero` slice of `HomeContent`.

  Headline segments, supporting copy, the primary CTA label, and the banner image. The headline is an array of segments rather than a string so the brand-coloured words can be marked up per run and wrap differently across breakpoints.

  Returns the section payload directly, unwrapped — so the client type is just
  the section interface, with no envelope to peel off.
}
