meta {
  name: Trusted By
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/home/trusted-by
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.status: eq 200
  res.body.error: isNull
  res.body.data.heading: isArray
  res.body.data.logos: isArray
  res.body.data.logos: length 8
}

docs {
  # Trusted By

  `GET /api/home/trusted-by` → the `trustedBy` slice of `HomeContent`.

  Client logo wall. Eight entries; Alteryx and UiPath each appear twice, which is why every logo carries an explicit `id` rather than being keyed by name.

  The section payload arrives under `data`; see the collection docs for the
  response envelope.
}
