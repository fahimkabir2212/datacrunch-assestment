meta {
  name: Product Showcase
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/home/product-showcase
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.status: eq 200
  res.body.error: isNull
  res.body.data.heading: isString
  res.body.data.logo: isDefined
  res.body.data.image: isDefined
}

docs {
  # Product Showcase

  `GET /api/home/product-showcase` → the `productShowcase` slice of `HomeContent`.

  The AmICredible product band — brand logo, copy, CTA, and product screenshot.

  The section payload arrives under `data`; see the collection docs for the
  response envelope.
}
