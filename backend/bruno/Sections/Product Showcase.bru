meta {
  name: Product Showcase
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/home/product-showcase
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.heading: isString
  res.body.logo: isDefined
  res.body.image: isDefined
}

docs {
  # Product Showcase

  `GET /api/home/product-showcase` → the `productShowcase` slice of `HomeContent`.

  The AmICredible product band — brand logo, copy, CTA, and product screenshot.

  Returns the section payload directly, unwrapped — so the client type is just
  the section interface, with no envelope to peel off.
}
