meta {
  name: Tech Stack
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/home/tech-stack
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.items: isArray
  res.body.items: length 18
}

docs {
  # Tech Stack

  `GET /api/home/tech-stack` → the `techStack` slice of `HomeContent`.

  Eighteen technology logos rendered as scrolling marquee rows, plus the section heading and description.

  Returns the section payload directly, unwrapped — so the client type is just
  the section interface, with no envelope to peel off.
}
