meta {
  name: Tech Stack
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/home/tech-stack
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.status: eq 200
  res.body.error: isNull
  res.body.data.items: isArray
  res.body.data.items: length 18
}

docs {
  # Tech Stack

  `GET /api/home/tech-stack` → the `techStack` slice of `HomeContent`.

  Eighteen technology logos rendered as scrolling marquee rows, plus the section heading and description.

  The section payload arrives under `data`; see the collection docs for the
  response envelope.
}
