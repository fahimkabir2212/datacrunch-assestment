meta {
  name: About
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/home/about
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.status: eq 200
  res.body.error: isNull
  res.body.data.eyebrow: isString
  res.body.data.heading: isArray
}

docs {
  # About

  `GET /api/home/about` → the `about` slice of `HomeContent`.

  The short positioning statement. The heading uses the same segment array as the hero so the bold lead-in and the regular remainder can be styled independently.

  The section payload arrives under `data`; see the collection docs for the
  response envelope.
}
