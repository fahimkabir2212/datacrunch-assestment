meta {
  name: About
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/home/about
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.eyebrow: isString
  res.body.heading: isArray
}

docs {
  # About

  `GET /api/home/about` → the `about` slice of `HomeContent`.

  The short positioning statement. The heading uses the same segment array as the hero so the bold lead-in and the regular remainder can be styled independently.

  Returns the section payload directly, unwrapped — so the client type is just
  the section interface, with no envelope to peel off.
}
