meta {
  name: Solutions
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/home/solutions
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.status: eq 200
  res.body.error: isNull
  res.body.data.tabs: isArray
  res.body.data.tabs: length 3
}

docs {
  # Solutions

  `GET /api/home/solutions` → the `solutions` slice of `HomeContent`.

  The three solution tabs. Each carries a `scrollTargetId` naming the DOM id it jumps to — these are in-page navigation, not a content switcher.

  The section payload arrives under `data`; see the collection docs for the
  response envelope.
}
