meta {
  name: Pillar Detail
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/home/pillar-detail
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.index: isString
  res.body.cards: isArray
  res.body.cards: length 3
}

docs {
  # Pillar Detail

  `GET /api/home/pillar-detail` → the `pillarDetail` slice of `HomeContent`.

  The numbered pillar block and its three supporting cards.

  Returns the section payload directly, unwrapped — so the client type is just
  the section interface, with no envelope to peel off.
}
