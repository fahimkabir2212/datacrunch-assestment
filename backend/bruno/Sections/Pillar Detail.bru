meta {
  name: Pillar Detail
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/home/pillar-detail
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.status: eq 200
  res.body.error: isNull
  res.body.data.index: isString
  res.body.data.cards: isArray
  res.body.data.cards: length 3
}

docs {
  # Pillar Detail

  `GET /api/home/pillar-detail` → the `pillarDetail` slice of `HomeContent`.

  The numbered pillar block and its three supporting cards.

  The section payload arrives under `data`; see the collection docs for the
  response envelope.
}
